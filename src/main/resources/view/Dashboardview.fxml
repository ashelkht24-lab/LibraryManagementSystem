<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="590.0" prefWidth="750.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
    </padding>
    <children>
        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="System Overview" />

        <GridPane hgap="20.0" layoutX="30.0" layoutY="80.0" vgap="20.0">
            <children>
                <!-- Total Books Card -->
                <VBox prefHeight="120.0" prefWidth="220.0" styleClass="stat-card, card-blue" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Total Books" />
                        <Label styleClass="card-value" text="250" />
                    </children>
                </VBox>

                <!-- Total Members Card -->
                <VBox prefHeight="120.0" prefWidth="220.0" styleClass="stat-card, card-green" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Total Members" />
                        <Label styleClass="card-value" text="120" />
                    </children>
                </VBox>

                <!-- Currently Borrowed Card -->
                <VBox prefHeight="120.0" prefWidth="220.0" styleClass="stat-card, card-orange" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Currently Borrowed" />
                        <Label styleClass="card-value" text="45" />
                    </children>
                </VBox>

                <!-- Overdue Books Card -->
                <VBox prefHeight="120.0" prefWidth="220.0" styleClass="stat-card, card-red" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
                    <children>
                        <Label styleClass="card-title" text="Overdue Books" />
                        <Label styleClass="card-value" text="8" />
                    </children>
                </VBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>
