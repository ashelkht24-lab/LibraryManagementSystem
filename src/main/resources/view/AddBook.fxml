<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.icet.library.controller.AddBookController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <children>
        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="Add New Book" />

        <GridPane hgap="15.0" layoutX="30.0" layoutY="80.0" vgap="15.0">
            <children>
                <Label text="Book ID / ISBN:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtIsbn" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Book Title:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtTitle" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Author:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtAuthor" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbCategory" prefWidth="300.0" promptText="Select Category" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Published Year:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtYear" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <Label text="Quantity:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextField fx:id="txtQuantity" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <children>
                        <Button onAction="#btnAddBookOnAction" styleClass="primary-button" text="Add Book" />
                        <Button onAction="#btnClearOnAction" styleClass="secondary-button" text="Clear" />
                    </children>
                </HBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>s