<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.icet.library.controller.AddMemberController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <children>
        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="Register New Member" />

        <GridPane hgap="15.0" layoutX="30.0" layoutY="80.0" vgap="15.0">
            <children>
                <Label text="Member ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtMemberId" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtFullName" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtEmail" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Phone Number:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtPhone" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtAddress" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <children>
                        <Button onAction="#btnRegisterMemberOnAction" styleClass="primary-button" text="Register Member" />
                        <Button onAction="#btnClearOnAction" styleClass="secondary-button" text="Clear" />
                    </children>
                </HBox>
            </children>
        </GridPane>
    </children>
</AnchorPane>