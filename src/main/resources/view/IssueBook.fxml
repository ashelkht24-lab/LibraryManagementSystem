<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550.0" prefWidth="700.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.icet.library.controller.IssueBookController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <children>
        <Label layoutX="30.0" layoutY="20.0" styleClass="page-title" text="Issue Book" />

        <GridPane hgap="15.0" layoutX="30.0" layoutY="80.0" vgap="15.0">
            <children>
                <Label text="Select Member:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="cmbMember" prefWidth="300.0" promptText="Choose Member" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Select Book:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbBook" prefWidth="300.0" promptText="Choose Book" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Issue Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpIssueDate" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <DatePicker fx:id="dpDueDate" prefWidth="300.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Button onAction="#btnIssueBookOnAction" styleClass="primary-button" text="Issue Book" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>
    </children>
</AnchorPane>