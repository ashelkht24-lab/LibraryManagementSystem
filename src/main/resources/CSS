/* Header & Sidebar Styles */
.header-bar {
    -fx-background-color: #2c3e50;
}
.header-title {
    -fx-font-size: 18px;
    -fx-font-weight: bold;
    -fx-text-fill: white;
}
.sidebar {
    -fx-background-color: #34495e;
}
.nav-button {
    -fx-background-color: transparent;
    -fx-text-fill: #ecf0f1;
    -fx-font-size: 14px;
    -fx-alignment: CENTER_LEFT;
    -fx-pref-height: 40px;
}
.nav-button:hover {
    -fx-background-color: #1abc9c;
    -fx-text-fill: white;
}
.logout-button {
    -fx-background-color: #e74c3c;
    -fx-text-fill: white;
    -fx-font-weight: bold;
    -fx-pref-height: 40px;
}
.logout-button:hover {
    -fx-background-color: #c0392b;
}
.page-title {
    -fx-font-size: 22px;
    -fx-font-weight: bold;
    -fx-text-fill: #2c3e50;
}

/* Stat Cards */
.stat-card {
    -fx-background-radius: 8px;
}
.card-title {
    -fx-font-size: 14px;
    -fx-text-fill: white;
}
.card-value {
    -fx-font-size: 32px;
    -fx-font-weight: bold;
    -fx-text-fill: white;
}
.card-blue { -fx-background-color: #3498db; }
.card-green { -fx-background-color: #2ecc71; }
.card-orange { -fx-background-color: #f39c12; }
.card-red { -fx-background-color: #e74c3c; }tt